# NeuroClaw Growth P0 — environment template
# Copy to .env and fill in real values. Never commit the filled file.

# ---------------------------------------------------------------------------
# Persistence (R2-A1: Postgres 16 + pgvector via Drizzle)
# Production uses a real Postgres; local dev offers two zero-infra options.
# ---------------------------------------------------------------------------
# Real Postgres (docker compose -f docker-compose.dev.yml up -d):
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/neuroclaw
# Embedded Postgres (PGlite) persisted to a local directory — no Docker needed:
# DATABASE_URL=file:./data/neuroclaw-pg
# In-memory (tests / throwaway dev):
# DATABASE_URL=:memory:

# ---------------------------------------------------------------------------
# Control-plane HTTP server
# ---------------------------------------------------------------------------
PORT=8787
HOST=0.0.0.0

# Production safety gate (Round J): with NODE_ENV=production the server
# REFUSES to start unless DATABASE_URL is persistent and NEUROCLAW_API_KEYS
# is non-empty. Leave unset for local dev (in-memory DB + dev-admin auth).
# NODE_ENV=production

# API key auth. Format: key:user:role pairs, comma-separated.
# Roles: admin | operator | viewer. Requests need "Authorization: Bearer <key>" or "X-API-Key".
# WARNING: when unset, the server runs in dev mode — every request is treated as admin.
NEUROCLAW_API_KEYS=change-me-admin-key:founder:admin,change-me-viewer-key:ops:viewer

# Optional override for the built frontend directory served by control-plane.
# Defaults to <repo>/apps/web/dist resolved automatically.
# NEUROCLAW_STATIC_DIR=

# ---------------------------------------------------------------------------
# Real AI capability (Vercel AI SDK). Without a key, runs fall back to mock.
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# NEUROCLAW_AI_MODEL=gpt-4o
# NEUROCLAW_AI_MODEL=claude-sonnet-4-20250514
# LLM call guard (Round J): retries on provider errors + hard timeout per call.
# NEUROCLAW_AI_MAX_RETRIES=2
# NEUROCLAW_AI_TIMEOUT_MS=120000
# Opt-in cost estimation persisted to runs.cost_usd (USD per 1M tokens).
# NEUROCLAW_AI_COST_USD_PER_1M_TOKENS=3

# ---------------------------------------------------------------------------
# Approved delivery channels (checked in order: webhook -> SMTP -> preview)
# Webhook receives POST JSON { runId, templateType, actionType, recipientEmail, draft }.
# Use it to hand off to external channel systems (WeCom / Xiaohongshu / CRM...).
# ---------------------------------------------------------------------------
# NEUROCLAW_DELIVERY_WEBHOOK_URL=https://hooks.example.com/neuroclaw

# SMTP email delivery (requires nodemailer to be installed; optional dependency).
# Either a single URL or discrete host vars. Requires recipientEmail on the run input.
# NEUROCLAW_SMTP_URL=smtps://user:pass@smtp.example.com:465
# NEUROCLAW_SMTP_HOST=smtp.example.com
# NEUROCLAW_SMTP_PORT=587
# NEUROCLAW_SMTP_USER=apikey
# NEUROCLAW_SMTP_PASS=your-smtp-password
# NEUROCLAW_SMTP_SECURE=1

# ---------------------------------------------------------------------------
# MCP tool servers (official @modelcontextprotocol/sdk)
# JSON array of { name, type: stdio|sse|http, command/args/env | url }
# When absent, generation falls back to agent-core direct LLM calls.
# ---------------------------------------------------------------------------
# NEUROCLAW_MCP_SERVERS=[{"name":"growth-tools","type":"stdio","command":"node","args":["tools/growth-mcp.js"]}]

# ---------------------------------------------------------------------------
# Browser automation (Playwright). Set to 1 to disable real browser extraction.
# ---------------------------------------------------------------------------
# NEUROCLAW_BROWSER_DISABLED=1

# ---------------------------------------------------------------------------
# OpenTelemetry (optional). SDK activates only when an endpoint is set or
# NEUROCLAW_OTEL_ENABLED=1. Falls back to InMemoryTraceLog otherwise.
# ---------------------------------------------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer%20your-token
# OTEL_SERVICE_NAME=neuroclaw-control-plane
# NEUROCLAW_OTEL_ENABLED=1
