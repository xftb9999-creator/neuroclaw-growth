{
    "name": "neuroclaw-growth-p0",
    "version": "0.2.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=20"
    },
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "build": "tsc -b && vite build --config apps/web/vite.config.ts && node scripts/write-release-manifest.mjs && node scripts/verify-release-manifest.mjs",
        "dev": "turbo run dev",
        "start": "node ./apps/control-plane/dist/server.js",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "npm run build && playwright test",
        "assert:bundle": "node scripts/assert-web-bundle.mjs",
        "assert:release": "node scripts/verify-release-manifest.mjs",
        "gate:r1": "node scripts/gate-report.mjs",
        "typecheck": "tsc -b --pretty false && tsc --noEmit -p apps/web/tsconfig.json"
    },
    "devDependencies": {
        "@hono/node-server": "^1.14.1",
        "@playwright/test": "^1.59.1",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.6",
        "@types/node": "^24.6.0",
        "@types/pg": "^8.23.1",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.2.0",
        "@vitest/coverage-v8": "^5.0.0",
        "jsdom": "^30.0.1",
        "tsx": "^4.23.12",
        "turbo": "^2.5.6",
        "typescript": "^5.9.3",
        "vite": "^7.3.2",
        "vitest": "^5.0.0"
    },
    "dependencies": {
        "@ai-sdk/anthropic": "^4.0.23",
        "@ai-sdk/openai": "^4.0.23",
        "@electric-sql/pglite": "^0.5.7",
        "@electric-sql/pglite-pgvector": "^0.0.8",
        "@modelcontextprotocol/sdk": "^1.29.0",
        "@opentelemetry/api": "^1.9.1",
        "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
        "@opentelemetry/resources": "~2.10.0",
        "@opentelemetry/sdk-node": "^0.221.0",
        "@opentelemetry/semantic-conventions": "^1.36.0",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/react-query": "^5.102.3",
        "ai": "^7.0.41",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "drizzle-orm": "^0.45.2",
        "hono": "^4.8.5",
        "lucide-react": "^1.27.0",
        "pg": "^8.23.0",
        "playwright": "^1.62.0",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4.3.3",
        "zod": "^4.1.5"
    }
}
